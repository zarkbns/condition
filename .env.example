# ---------------------------------------------------------------------------
# Condition — environment configuration
#
# Copy to .env and adjust. Secrets (MIDNIGHT_WALLET_SEED) are env-only —
# NEVER commit real values.
# ---------------------------------------------------------------------------

# Preprod network endpoints (consumed by src/utils/preprodRuntime.ts via
# preprodConfigFromEnv; the values below are the Midnight Preprod defaults
# compiled into PREPROD_ENDPOINTS, so overriding is only needed to point at a
# different network or a local dev stack). Indexer uses API v4 — the retired
# testnet-02 network used /api/v1 and no longer resolves.
NEXT_PUBLIC_MIDNIGHT_INDEXER=https://indexer.preprod.midnight.network/api/v4/graphql
NEXT_PUBLIC_MIDNIGHT_INDEXER_WS=wss://indexer.preprod.midnight.network/api/v4/graphql/ws
# No hosted Preprod prover exists — run a local Docker proof server:
#   docker run -p 6300:6300 midnightntwrk/proof-server:latest midnight-proof-server -v
NEXT_PREPROD_PROVER=http://127.0.0.1:6300
NEXT_PREPROD_NODE=https://rpc.preprod.midnight.network
NEXT_PUBLIC_MIDNIGHT_NETWORK=Preprod

# Wallet seed for the CLI/Node path (deploy/deploy.ts, scripts/e2e-preprod.ts,
# and the browser fallback when no Lace extension is present). Funded preprod
# seed, hex-encoded. Env-only — never commit it.
# MIDNIGHT_WALLET_SEED=0x...

# Midnight node URL for deploy/deploy.ts (optional — defaults to the Preprod
# RPC endpoint). MIDNIGHT_PROVER_URL optionally overrides the proof server
# (defaults to the local Docker proof server on localhost:6300).
MIDNIGHT_NODE_URL=https://rpc.preprod.midnight.network

# Frontend public config
NEXT_PUBLIC_APP_NAME=Condition
