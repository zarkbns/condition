# ---------------------------------------------------------------------------
# Condition — environment configuration
#
# Copy to .env and adjust. Secrets (MIDNIGHT_WALLET_SEED) are env-only —
# NEVER commit real values.
# ---------------------------------------------------------------------------

# Preprod network endpoints (consumed by src/utils/preprodRuntime.ts via
# preprodConfigFromEnv; the values below are the Midnight testnet-02 defaults
# compiled into PREPROD_ENDPOINTS, so overriding is only needed to point at a
# different network or a local dev stack).
NEXT_PUBLIC_MIDNIGHT_INDEXER=https://indexer.testnet-02.midnight.network/api/v1/graphql
NEXT_PUBLIC_MIDNIGHT_INDEXER_WS=wss://indexer.testnet-02.midnight.network/api/v1/graphql/ws
NEXT_PREPROD_PROVER=https://prover.testnet-02.midnight.network
NEXT_PREPROD_NODE=https://rpc.testnet-02.midnight.network
NEXT_PUBLIC_MIDNIGHT_NETWORK=Preprod TestNet

# Wallet seed for the CLI/Node path (deploy/deploy.ts, scripts/e2e-preprod.ts,
# and the browser fallback when no Lace extension is present). Funded testnet
# seed, hex-encoded. Env-only — never commit it.
# MIDNIGHT_WALLET_SEED=0x...

# Midnight node URL for deploy/deploy.ts (optional — defaults to the
# testnet-02 RPC endpoint).
MIDNIGHT_NODE_URL=https://rpc.testnet-02.midnight.network

# Frontend public config
NEXT_PUBLIC_APP_NAME=Condition
